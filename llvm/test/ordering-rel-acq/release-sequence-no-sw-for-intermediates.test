// RUN: %gentest -t %t llvm %s

// Release/Acquire synchronize even if they only read from each other via a
// sequence of RMWs.
// That synchronization does however not include loads or stores in the threads
// of the RMWs.

#thread 0
  $A: store p1
  $X: store.release p2

#thread 1
  $RW1: rmw.monotonic p2
  $L1: load p1

#thread 2
  $RW2: rmw.monotonic p2

#thread 3
  $Y: load.acquire p2
  $B: load p1

#push llvm_memory_model

#push ($X -> $RW1) + ($RW1 -> $RW2) + ($RW2 -> $Y) in rf
#check sat
#check unsat ($X -> $Y) not in llvm_sw
#check sat $L1 in DataRaceRead
