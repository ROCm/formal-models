// RUN: %gentest -t %t llvm %s

// If $Y reads from $X, $B must read from $A because of fence synchronization.

#thread 0
  $A: store p1
  fence.release
  $X: store.monotonic p2

#thread 1
  $Y: load.monotonic p2
  fence.acquire
  $B: load p1

#push llvm_memory_model

#check sat ($X -> $Y) in rf and ($A -> $B) in rf

#assert ($X -> $Y) in rf => ($A -> $B) in rf
