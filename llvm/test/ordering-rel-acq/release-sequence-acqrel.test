// RUN: %gentest -t %t llvm %s

// Release/Acquire synchronize even if they only read from each other via a
// sequence of RMWs.

#thread 0
  $A: store.unordered p1
  $X: store.release p2

#thread 1
  $RW1: rmw.acq_rel p2
  $B1: load.unordered p1

#thread 2
  $Y: load.acquire p2
  $B: load.unordered p1

#push llvm_memory_model

#push ($X -> $RW1) + ($RW1 -> $Y) in rf
#check sat
#check unsat ($X -> $Y) not in llvm_sw
#check unsat ($A -> $B) not in rf
#check unsat ($A -> $B1) not in rf
