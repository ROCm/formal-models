// RUN: %gentest -t %t llvm %s

// Release/Acquire synchronize even if they only read from each other via a
// sequence of RMWs.

#thread 0
  $A: store.unordered p1
  $FR: fence.release
  $X: store.monotonic p2

#thread 1
  $RW1: rmw.monotonic p2

#thread 2
  $RW2: rmw.monotonic p2

#thread 3
  $Y: load.monotonic p2
  $FA: fence.acquire
  $B: load.unordered p1

#push llvm_memory_model

#push ($X -> $RW1) + ($RW1 -> $RW2) + ($RW2 -> $Y) in rf
#check sat
#check unsat ($A -> $B) not in rf
#check unsat ($FR -> $FA) not in llvm_sw
