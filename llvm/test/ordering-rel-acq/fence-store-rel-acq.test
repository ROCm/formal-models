// RUN: %gentest -t %t llvm %s

// If $Y reads from $X, $B must read from $A because of release/acquire
// synchronization. In that case, there is no data race.

#thread 0
  $A: store p1
  $X: store.release p2

#thread 1
  $Y: load.monotonic p2
  fence.acquire
  $B: load p1

#push llvm_memory_model

// There can be a data race if $Y doesn't read from $X.
#check sat $B in DataRaceRead

#push ($X -> $Y) in rf

#check sat ($A -> $B) in rf
#check unsat ($A -> $B) not in rf
#check unsat $B in DataRaceRead

