// RUN: %gentest -t %t llvm %s

#thread 0
  $S1: store.monotonic p
  $R: store.release f

#thread 1
  $S2: store.monotonic p
  $A: load.acquire f
  $L: load.monotonic p

#push llvm_memory_model

// This is not a data race, all accesses are atomic. It doesn't matter if $R and
// $A synchronize.
#check sat
#assert no DataRaceRead

