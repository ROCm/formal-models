// RUN: %gentest -t %t llvm %s

#thread 0
  $S1: store.monotonic p
  $R: store.release f

#thread 1
  $S2: store.monotonic p
  $A: load.acquire f
  $L: load p

#push llvm_memory_model

#push $R -> $A not in rf

// This is a data race, $S1 races with $L.
#check sat
#assert $L in DataRaceRead

#pop
#push $R -> $A in rf

// This is not a data race: $S1 and $S2 are monotonic, and $L happens-after both of them.
#check sat
#assert no DataRaceRead

#pop
