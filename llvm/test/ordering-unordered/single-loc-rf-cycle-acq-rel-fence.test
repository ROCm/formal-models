// RUN: %gentest -t %t llvm %s

#thread 0
  $L: load.unordered p
  $F: fence.acq_rel
  $S: store.unordered p

#thread 1
  $M: rmw.monotonic p

#push llvm_memory_model

// rf-chains for synchronization can't start or end with unordered atomics, so
// the fence does nothing.
#check sat ($S -> $M) + ($M -> $L) in rf

