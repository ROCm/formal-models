// RUN: %gentest -t %t.full llvm-amdgpu --scope-encoding=full %s
// RUN: %gentest -t %t.optimized llvm-amdgpu --scope-encoding=optimized %s

// This encodes the HSA litmus test "4. Synchronization through multiple scopes"
// from HSA's "Representative Litmus Tests" (Version 1.2):
// https://hsafoundation.com/wp-content/uploads/2021/02/cat_TestCases-1.2.pdf
// Note that HSA's scacq and screl orderings correspond to C++'s and LLVM's
// seq_cst ordering, not the acquire and release orderings.

#agent 0
#cluster 0
#workgroup 0
#wave 0
#thread 0
  $SX53: store x
  $SY1: store.seq_cst.ss=wg y

#wave 1
#thread 1
  $LY: load.seq_cst.ss=wg y
  $LX1: load x
  $SZ1: store.seq_cst.ss=system z

#cluster 1
#workgroup 1
#wave 2
#thread 2
  $LZ: load.seq_cst.ss=system z
  $LX2: load x

#push amdgpu_memory_model

#push ($SY1 -> $LY) + ($SZ1 -> $LZ) in rf

#check sat ($SX53 -> $LX1) + ($SX53 -> $LX2) in rf
#check unsat $LX2 in InitRead
