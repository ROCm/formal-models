// RUN: %gentest -t %t.full llvm-amdgpu --scope-encoding=full %s
// RUN: %gentest -t %t.optimized llvm-amdgpu --scope-encoding=optimized %s

// This encodes the HSA litmus test "8. Synchronization between units of
// execution using relaxed atomics" from HSA's "Representative Litmus Tests"
// (Version 1.2):
// https://hsafoundation.com/wp-content/uploads/2021/02/cat_TestCases-1.2.pdf
// Note that HSA's scacq and screl orderings correspond to C++'s and LLVM's
// seq_cst ordering, not the acquire and release orderings.

#workgroup 0
#wave 0
#thread 0
  $SX53: store x
  $F1: fence.seq_cst.ss=wg
  $SY1: store.monotonic.ss=wg y

#wave 1
#thread 1
  $LY: load.monotonic.ss=wg y
  $F2: fence.seq_cst.ss=wg
  $LX: load x


#push amdgpu_memory_model

#push ($SY1 -> $LY) in rf

// The test as written in the HSA document claims that $LX should be able to
// read the initial value. That seems wrong and is certainly not the case for
// the LLVM memory model.
// #check sat $LX in InitRead

#check sat ($SX53 -> $LX) in rf
#check unsat $LX in InitRead
