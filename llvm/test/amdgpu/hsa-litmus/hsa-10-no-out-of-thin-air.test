// RUN: %gentest -t %t.full llvm-amdgpu --scope-encoding=full %s
// RUN: %gentest -t %t.optimized llvm-amdgpu --scope-encoding=optimized %s

// This encodes the HSA litmus test "10. No out-of-thin-air values" from HSA's
// "Representative Litmus Tests" (Version 1.2):
// https://hsafoundation.com/wp-content/uploads/2021/02/cat_TestCases-1.2.pdf
// Note that HSA's scacq and screl orderings correspond to C++'s and LLVM's
// seq_cst ordering, not the acquire and release orderings.

#workgroup 0
#wave 0
#thread 0
  $LX: load.monotonic x
  $SY: store.monotonic y

#wave 1
#thread 1
  $LY: load.monotonic y
  $SX: store.monotonic x


#push amdgpu_memory_model

// LLVM's monotonic accesses allow out-of-thin-air values, so this test is not
// valid for the LLVM memory model.

#check sat

// #check unsat ($SX -> $LX) + ($SY -> $LY) in rf
#check sat ($SX -> $LX) + ($SY -> $LY) in rf
