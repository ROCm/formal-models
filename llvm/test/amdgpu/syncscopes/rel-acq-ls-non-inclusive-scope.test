// RUN: %gentest -t %t.full llvm-amdgpu --scope-encoding=full %s
// RUN: %gentest -t %t.optimized llvm-amdgpu --scope-encoding=optimized %s

#workgroup 0
#wave 0
#thread 0
  $S: store data
  $A: store.release.ss=wavefront p

#wave 1
#thread 1
  $B: load.acquire.ss=wavefront p
  $L: load data

#push amdgpu_memory_model

// These cannot synchronize since their scopes are not inclusive.

#check sat
#check unsat ($A -> $B) in llvm_sw
