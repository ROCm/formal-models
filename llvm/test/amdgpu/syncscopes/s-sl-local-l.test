// RUN: %gentest -t %t llvm-amdgpu %s

#agent 0
#workgroup 0
#thread 0
  $S1: store.monotonic.ss=agent p
  $R: store.release f

#workgroup 1
#thread 1
  $S2: store.monotonic.ss=agent p
  $A: load.acquire f
  $L: load.monotonic.ss=workgroup p

#push amdgpu_memory_model

#push $R -> $A not in rf

// This is a data race, $S1 races with $L (they don't have inclusive scope).
#check sat
#assert $L in DataRaceRead

#pop
#push $R -> $A in rf

// This is not a data race: $S1 and $S2 have inclusive scope, and $L
// happens-after both of them.
#check sat
#assert no DataRaceRead

#pop
