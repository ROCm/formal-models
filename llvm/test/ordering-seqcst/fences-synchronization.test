// RUN: %gentest -t %t llvm %s

// SeqCst fences also release and acquire.

#thread 0
  $A: store p1
  fence.seq_cst
  $X: store.monotonic p2

#thread 1
  $Y: load.monotonic p2
  fence.seq_cst
  $B: load p1

#push llvm_memory_model

#check sat ($X -> $Y) in rf and ($A -> $B) in rf

#check unsat ($X -> $Y) in rf and ($A -> $B) not in rf
