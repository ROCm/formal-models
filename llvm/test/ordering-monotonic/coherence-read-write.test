// RUN: %gentest -t %t llvm %s

#thread 0
  $S1: store.monotonic p

#thread 1
  $L: load.monotonic p
  $S2: store.monotonic p

#thread 2
  $L1: load.monotonic p
  $L2: load.monotonic p

#push llvm_memory_model

#check sat

#assert no DataRaceRead
#check sat $L in InitRead
#check sat ($S1 -> $L) in rf
#check unsat ($S2 -> $L) in rf

// The current LLVM model allows this outcome, even though C++'s read-write
// coherence rule disallows it:
#check sat $S1 -> $L + $S2 -> $L1 + $S1 -> $L2 in rf

