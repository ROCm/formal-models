// RUN: %gentest -t %t llvm %s

#thread 0
  $S1: store.monotonic p

#thread 1
  $S2: store.monotonic p
  $S3: store.unordered p
  $L: load.monotonic p

#thread 2
  $L1: load.monotonic p
  $L2: load.monotonic p

#push llvm_memory_model

#check sat

#assert no DataRaceRead
#check sat ($S1 -> $L) in rf
#check unsat ($S2 -> $L) in rf
#check sat ($S3 -> $L) in rf

// C++'s write-read coherence rule disallows this behavior:
#check unsat $S1 -> $L + $S1 -> $L1 + $S2 -> $L2 in rf

